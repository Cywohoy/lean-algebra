{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "교재 생성",
      "type": "process",
      "command": "lake",
      "args": [
        "exe",
        "textbook"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "웹 실행 환경 준비",
      "type": "process",
      "command": "python",
      "args": [
        "scripts/prepare_pages.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "교재 생성"
      ],
      "problemMatcher": []
    },
    {
      "label": "교재 미리보기",
      "type": "process",
      "command": "python",
      "args": [
        "web/serve.py",
        "--port",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "웹 실행 환경 준비"
      ],
      "problemMatcher": []
    }
  ]
}
